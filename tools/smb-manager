# ===== DISPATCHER =====
smb_manager::run() {
  case "$CMD" in
  create)
    smb_manager::acquire_write_lock
    smb_manager::create "${GLOBAL_ARGS[@]:-}"
    ;;
  unmount)
    smb_manager::acquire_write_lock
    smb_manager::unmount "${GLOBAL_ARGS[@]:-}"
    ;;
  status)  smb_manager::status  "${GLOBAL_ARGS[@]:-}" ;;
  verify)  smb_manager::verify  "${GLOBAL_ARGS[@]:-}" ;;
  health)  smb_manager::health  "${GLOBAL_ARGS[@]:-}" ;;
  export)  smb_manager::export  "${GLOBAL_ARGS[@]:-}" ;;
  import)  smb_manager::import  "${GLOBAL_ARGS[@]:-}" ;;
  help|"") smb_manager::usage ;;
  *)
    msg_err "Unknown command: $CMD"
    smb_manager::usage >&2
    exit 2
    ;;
  esac
}

# Environment check first — hard exits on WSL1 / unprivileged LXC
smb_manager::check_environment

if [[ -n "$CMD" ]]; then
  smb_manager::run
  exit $?
fi

# Interactive menu (no-arg curl invocation)
while :; do
  clear >/dev/null 2>&1 || true
  smb_manager::list_cifs_mounts || true
  printf '\n' >&2
  printf "Choose an action:\n" >&2
  printf "  1) Unmount / clean an existing SMB mount\n" >&2
  printf "  2) Create a new persistent SMB mount\n" >&2
  printf "  3) Status (enhanced)\n" >&2
  printf "  4) Verify (self-tests)\n" >&2
  printf "  5) Health (rw test)\n" >&2
  printf "  0) Exit\n\n" >&2
  printf "  (export / import not yet implemented)\n" >&2
  case "$(tui_prompt "Select [0-5]")" in
  1) smb_manager::unmount; read -rp $'\nPress Enter to continue... ' _ ;;
  2) smb_manager::create;  read -rp $'\nPress Enter to continue... ' _ ;;
  3) smb_manager::status;  read -rp $'\nPress Enter to continue... ' _ ;;
  4) smb_manager::verify;  read -rp $'\nPress Enter to continue... ' _ ;;
  5) smb_manager::health;  read -rp $'\nPress Enter to continue... ' _ ;;
  0) msg_info "Bye."; exit 0 ;;
  *) msg_warn "Unknown choice."; sleep 1 ;;
  esac
done
